# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/booking-system

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# ─── Business ─────────────────────────────────────────────────────────────────
BUSINESS_NAME=BookEasy
FRONTEND_URL=http://localhost:5173

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Gmail example: set SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false
# Use an App Password (not your Gmail password) if 2FA is enabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# ─── WhatsApp (Twilio) ────────────────────────────────────────────────────────
# Sign up at https://twilio.com, enable the WhatsApp Sandbox
# TWILIO_WHATSAPP_FROM is your Twilio sandbox number e.g. +14155238886
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886
